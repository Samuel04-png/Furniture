rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function canonicalRole(value) {
      return value == 'Owner' || value == 'owner' ? 'Owner'
        : value == 'Admin' || value == 'admin' ? 'Admin'
        : value == 'Sales' || value == 'sales' ? 'Sales'
        : value == 'Designer' || value == 'designer' ? 'Designer'
        : value == 'Production Manager' || value == 'production manager' ? 'Production Manager'
        : value == 'Inventory Manager' || value == 'inventory manager' ? 'Inventory Manager'
        : value == 'Procurement' || value == 'procurement' ? 'Procurement'
        : value == 'Accountant' || value == 'accountant' ? 'Accountant'
        : value == 'Read Only' || value == 'read only' || value == 'readonly' ? 'Read Only'
        : 'Read Only';
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? canonicalRole(request.auth.token.role)
        : 'Read Only';
    }

    function roleIn(roles) {
      return signedIn() && role() in roles;
    }

    function canReadPipeline() {
      return roleIn(['Owner', 'Admin', 'Sales', 'Designer', 'Accountant', 'Read Only']);
    }

    function canWritePipeline() {
      return roleIn(['Owner', 'Admin', 'Sales', 'Designer']);
    }

    function canReadJobs() {
      return roleIn(['Owner', 'Admin', 'Production Manager', 'Inventory Manager', 'Procurement', 'Read Only']);
    }

    function canWriteJobs() {
      return roleIn(['Owner', 'Admin', 'Production Manager']);
    }

    function canReadInventory() {
      return roleIn(['Owner', 'Admin', 'Inventory Manager', 'Production Manager', 'Procurement', 'Read Only']);
    }

    function canWriteInventory() {
      return roleIn(['Owner', 'Admin', 'Inventory Manager', 'Procurement']);
    }

    function canReadFinance() {
      return roleIn(['Owner', 'Admin', 'Accountant', 'Procurement', 'Read Only']);
    }

    function canWriteFinance() {
      return roleIn(['Owner', 'Admin', 'Accountant']);
    }

    function canReadProducts() {
      return roleIn(['Owner', 'Admin', 'Sales', 'Designer', 'Read Only']);
    }

    function canManageProducts() {
      return roleIn(['Owner', 'Admin', 'Sales', 'Designer']);
    }

    function canPublishProducts() {
      return roleIn(['Owner', 'Admin']);
    }

    function canManageSystem() {
      return roleIn(['Owner', 'Admin']);
    }

    function isPublicEnquiryCreate() {
      return !signedIn()
        && request.resource.data.keys().hasOnly([
          'id',
          'type',
          'clientName',
          'phone',
          'email',
          'productIds',
          'productNames',
          'status',
          'assignedTo',
          'channel',
          'createdAt',
          'notes',
          'configurationData',
          'visualiserSessionId',
          'visualiserScreenshot',
          'preferredContactTime',
          'createdBy',
          'updatedBy',
          'updatedAt'
        ])
        && request.resource.data.clientName is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && request.resource.data.productIds is list
        && request.resource.data.productNames is list
        && request.resource.data.createdAt is string
        && request.resource.data.notes is list
        && request.resource.data.type in ['visualiser', 'configurator', 'consultation', 'direct']
        && request.resource.data.status in ['New', 'Consultation Scheduled'];
    }

    function isPublicConsultationCreate() {
      return !signedIn()
        && request.resource.data.keys().hasOnly([
          'id',
          'enquiryId',
          'clientName',
          'phone',
          'email',
          'scheduledAt',
          'assignedDesigner',
          'status',
          'source',
          'notes',
          'visualiserSessionId',
          'createdBy',
          'updatedBy',
          'updatedAt'
        ])
        && request.resource.data.clientName is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && request.resource.data.scheduledAt is string
        && request.resource.data.notes is string
        && request.resource.data.status in ['Scheduled', 'Completed', 'Rescheduled', 'Cancelled'];
    }

    function isPublicVisualiserCreate() {
      return !signedIn()
        && request.resource.data.keys().hasOnly([
          'id',
          'roomPhotoUrl',
          'roomPhotoPath',
          'roomName',
          'placedItems',
          'submittedAt',
          'status',
          'clientName',
          'phone',
          'email',
          'assignedTo',
          'enquiryId',
          'createdBy',
          'updatedBy',
          'updatedAt'
        ])
        && request.resource.data.roomPhotoUrl is string
        && request.resource.data.roomName is string
        && request.resource.data.placedItems is list
        && request.resource.data.submittedAt is string
        && request.resource.data.status in ['New', 'Contacted', 'Consultation Booked', 'Closed'];
    }

    match /publishedProducts/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if canReadProducts();
      allow create: if canManageProducts();
      allow update: if canManageProducts()
        && (
          request.resource.data.status == resource.data.status
          || canPublishProducts()
        );
      allow delete: if canPublishProducts();
    }

    match /materials/{materialId} {
      allow read: if resource.data.visibleOnSite == true || canReadInventory();
      allow create, update, delete: if canWriteInventory();
    }

    match /sampleRooms/{roomId} {
      allow read: if resource.data.visibleOnSite == true || canManageSystem();
      allow create, update, delete: if canManageSystem();
    }

    match /testimonials/{testimonialId} {
      allow read: if resource.data.visibleOnSite == true || canManageSystem();
      allow create, update, delete: if canManageSystem();
    }

    match /portfolioProjects/{projectId} {
      allow read: if resource.data.visibleOnSite == true || canManageSystem();
      allow create, update, delete: if canManageSystem();
    }

    match /settings/companyProfile {
      allow read: if true;
      allow create, update: if canManageSystem();
      allow delete: if false;
    }

    match /settings/{docId} {
      allow read: if canManageSystem();
      allow write: if canManageSystem();
    }

    match /teamProfiles/{uid} {
      allow read: if resource.data.isPublicProfile == true || canManageSystem();
      allow write: if canManageSystem();
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if canManageSystem();
    }

    match /templates/{templateId} {
      allow read: if signedIn();
      allow create, update, delete: if canManageSystem();
    }

    match /automations/{automationId} {
      allow read: if signedIn();
      allow create, update, delete: if canManageSystem();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /enquiries/{enquiryId} {
      allow read: if canReadPipeline();
      allow create: if canWritePipeline() || isPublicEnquiryCreate();
      allow update: if canWritePipeline();
      allow delete: if canManageSystem();
    }

    match /consultations/{consultationId} {
      allow read: if canReadPipeline();
      allow create: if canWritePipeline() || isPublicConsultationCreate();
      allow update: if canWritePipeline();
      allow delete: if canManageSystem();
    }

    match /visualiserSessions/{sessionId} {
      allow read: if canReadPipeline();
      allow create: if canWritePipeline() || isPublicVisualiserCreate();
      allow update: if canWritePipeline();
      allow delete: if canManageSystem();
    }

    match /productionJobs/{jobId} {
      allow read: if canReadJobs();
      allow create, update: if canWriteJobs();
      allow delete: if canManageSystem();
    }

    match /inventoryItems/{inventoryId} {
      allow read: if canReadInventory();
      allow create, update: if canWriteInventory();
      allow delete: if canManageSystem();
    }

    match /accountingRecords/{recordId} {
      allow read: if canReadFinance();
      allow create, update: if canWriteFinance();
      allow delete: if canManageSystem();
    }

    match /auditLogs/{logId} {
      allow read: if canManageSystem();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
